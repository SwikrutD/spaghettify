# Static server for the Vite build. TLS is terminated in front of this (Cloudflare Tunnel or a
# reverse proxy), so Caddy only speaks plain HTTP inside the container.
{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	# Leaderboard API (the api container). The game copes when it is down: Caddy answers 502 and
	# the client treats that as offline. API_UPSTREAM lets a different host or port be used.
	# The api sets its own Cache-Control: no-store; errors get it from handle_errors below.
	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	# The online arena: a WebSocket on the same api server (Caddy passes the upgrade through and keeps the
	# connection open for as long as the game is played).
	handle /ws {
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	root * /srv

	# Vite puts content-hashed files in /assets: safe to cache forever.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# index.html (and anything else unhashed) must be revalidated so a deploy shows up at once.
	@unhashed not path /assets/* /api/* /ws
	header @unhashed Cache-Control "no-cache"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Precompressed .br/.gz files from scripts/precompress.mjs first, on-the-fly gzip for the rest.
	encode zstd gzip
	file_server {
		precompressed br gzip
	}

	# Never let a 404 (say, an asset requested mid-deploy) be cached as immutable.
	handle_errors {
		header Cache-Control "no-store"
		respond "{err.status_code} {err.status_text}"
	}
}
