{
  "name": "spaghettify",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "lint": "eslint .",
    "test": "npm run test:sim && npm run test:server && playwright test",
    "test:sim": "node --disable-warning=ExperimentalWarning --test \"src/sim/test/**/*.test.ts\"",
    "test:server": "npm --prefix server test",
    "server": "npm --prefix server run dev",
    "load": "npm --prefix server run load --",
    "probe": "npm --prefix server run probe --",
    "perf": "playwright test -c perf/playwright.perf.config.ts"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/three": "^0.186.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-glsl": "^1.6.2"
  }
}
